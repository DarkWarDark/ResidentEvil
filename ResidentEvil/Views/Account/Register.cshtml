@model ResidentEvil.Models.Users 

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card bg-dark border-danger text-white shadow">
                <div class="card-header bg-danger">
                    <h3 class="mb-0">U.B.C.S. REGISTRATION</h3>
                </div>
                <div class="card-body">
                    
                    <form asp-action="Register" method="post">
                        
                        @* CRITIC: Linia asta va afișa cu roșu textul exact al erorii dacă înregistrarea eșuează *@
                        <div asp-validation-summary="All" class="text-danger small mb-3 fw-bold"></div>

                        <div class="mb-3">
                            <label class="form-label">Username</label>
                            @* name="username" trebuie să fie identic cu cel din AccountController *@
                            <input name="username" type="text" class="form-control bg-secondary text-white border-0" required />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            @* name="password" trebuie să fie identic cu cel din AccountController *@
                            <input name="password" type="password" class="form-control bg-secondary text-white border-0" required />
                        </div>
                        
                        <button type="submit" class="btn btn-danger w-100 fw-bold">CREATE ACCOUNT</button>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>