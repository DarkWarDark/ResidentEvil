@{
    ViewData["Title"] = "Resident Evil 3";
}

<h1><i>Resident Evil 3</i></h1>

<div class="row">
    <div class="col-md-8">
        <div class="ratio ratio-16x9 mb-4 border border-danger">
            <video controls poster="~/images/re3.jpg" class="w-100">

                <source src="~/videos/testre9.mp4" type="video/mp4">
            </video>
        </div>

        <div class="wiki-card p-4">
            <p>
                Resident Evil 3 (Remake), is the remake of the original Resident Evil 3: Nemesis, which was released in 1999. 
                The remake was released on April 3, 2020, and features updated graphics, gameplay mechanics, and a reimagined storyline
                while retaining the core elements of the original game.
                
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="border border-danger">
            <div class="game-poster-box">
                <img src="~/photos/re3.jpg" class="img-fluid border border-secondary" alt="Nemesis Poster">
            </div>
        </div>
    </div>
</div>