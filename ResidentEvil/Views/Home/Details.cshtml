@model ResidentEvil.Models.Entry

<div class="container mt-5">
    <div class="card bg-dark text-white border-danger shadow-lg">
        <div class="card-header border-danger text-center">
            <h1 class="text-danger">DATABASE FILE: @Model.Name</h1>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    @* Presupunând că ai un câmp ImageUrl în baza de date *@
                    
                </div>
                <div class="col-md-8">
                    <h3 class="text-info">Information</h3>
                    <p><strong>Platform:</strong> @Model.Platform</p>
                    <p><strong>Release Year:</strong> @Model.ReleaseYear</p>
                    <hr class="bg-danger">
                    <h4 class="text-danger">Detailed Description:</h4>
                </div>
            </div>
        </div>
        <div class="card-footer border-danger">
            <a asp-action="Entries" class="btn btn-outline-light">Back to Archive</a>
        </div>
    </div>
</div>