@{
    ViewData["Title"] = "Resident Evil Requiem";
}

<h1><i>Resident Evil Requiem</i></h1> 

<div class="row">
    <div class="col-md-8">
        <div class="ratio ratio-16x9 mb-4 border border-danger">
            <video controls poster="~/images/requiem.jpg" class="w-100">
                
                <source src="~/videos/testre9.mp4" type="video/mp4"> 
            </video>
        </div>

        <div class="wiki-card p-4">
            <p>
                Resident Evil Requiem, stylized as RESIDENT EVIL requiem,also known as Resident Evil 9.
                It is the next mainline entry in the series following Resident Evil Village and was released on February 27, 2026.
            </p> 
        </div>
    </div>

    <div class="col-md-4">
        <div class="border border-danger">
            <div class="game-poster-box">
                <img src="~/photos/re9.jpg" class="img-fluid border border-secondary" alt="Requiem Poster"> 
            </div>
        </div>
    </div>
</div>