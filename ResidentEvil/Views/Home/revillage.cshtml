@{
    ViewData["Title"] = "Resident Evil Village";
}

<h1><i>Resident Evil Village</i></h1>

<div class="row">
    <div class="col-md-8">
        <div class="ratio ratio-16x9 mb-4 border border-danger">
            <video controls poster="~/images/revillage.jpg" class="w-100">

                <source src="~/videos/testre9.mp4" type="video/mp4">
            </video>
        </div>

        <div class="wiki-card p-4">
            <p>
                Resident Evil Village, also known as Resident Evil 8.
                It is the second game that follows the story of Ethan Winters, released on 7 May 2021.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="border border-danger">
            <div class="game-poster-box">
                <img src="~/photos/revillage.jpg" class="img-fluid border border-secondary" alt="Village Poster">
            </div>
        </div>
    </div>
</div>