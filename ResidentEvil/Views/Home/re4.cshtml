@{
    ViewData["Title"] = "Resident Evil 4";
}

<h1><i>Resident Evil 4</i></h1>

<div class="row">
    <div class="col-md-8">
        <div class="ratio ratio-16x9 mb-4 border border-danger">
            <video controls poster="~/images/re4.jpg" class="w-100">

                <source src="~/videos/testre9.mp4" type="video/mp4">
            </video>
        </div>

        <div class="wiki-card p-4">
            <p>
                Resident Evil 4 (Remake), is the remake of the original Resident Evil 4 released in 2005. The remake was released on March 24, 2023, for PlayStation 5, Windows, and Xbox Series X/S.
                It is a survival horror game developed and published by Capcom. The original game follows the story of Leon S. Kennedy,
                a government agent tasked with rescuing the President's daughter from a mysterious cult in rural Spain.
                

            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="border border-danger">
            <div class="game-poster-box">
                <img src="~/photos/re4.jpg" class="img-fluid border border-secondary" alt="Leon Poster">
            </div>
        </div>
    </div>
</div>