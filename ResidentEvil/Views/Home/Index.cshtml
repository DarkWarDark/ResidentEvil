@model IEnumerable<ResidentEvil.Models.Entry>
@{
    ViewData["Title"] = "Home";
}

<h1>Resident Evil Database</h1>

<div class="row justify-content-center mb-5">
    <div class="col-md-5">
        <div class="wiki-card">
            <p class="large-text">Welcome to the Resident Evil Wiki!</p>
            <p>
                This is a database for the Resident Evil universe, focusing on the Capcom's Resident Evil franchise...
            </p>
        </div>
    </div>
</div>

<div class="row text-center">
    @foreach (var item in Model)
    {
        // Entries with a hand-written page go to it; all others use the generic Details page
        var generic = string.IsNullOrEmpty(item.PageName) || item.PageName == "Details";
        var action = generic ? "Details" : item.PageName;
        int? entryId = generic ? item.Id : (int?)null;

        <div class="col-md-3 mb-4">
            <a asp-controller="Home" asp-action="@action" asp-route-id="@entryId" class="game-link">
                <div class="game-box">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="game-img" alt="@item.Name">
                    }
                    else
                    {
                        <div class="game-img d-flex align-items-center justify-content-center bg-dark text-secondary">
                            No image
                        </div>
                    }
                    <div class="game-info">
                        <h6><i>@item.Name</i></h6>
                        <span>(@item.ReleaseYear.Year)</span>
                    </div>
                </div>
            </a>
        </div>
    }

    @if (!Model.Any())
    {
        <p class="text-secondary">No featured entries yet.</p>
    }
</div>