@model IEnumerable<ResidentEvil.Models.Entry>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-danger">ARCHIVED ENTRIES</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Games" asp-action="Create" class="btn btn-outline-danger">Create New Page</a>
        }
    </div>

    <div class="btn-group mb-4" role="group">
        <button type="button" class="btn btn-outline-secondary active filter-btn" onclick="filterEntries('all', this)">All</button>
        <button type="button" class="btn btn-outline-danger filter-btn" onclick="filterEntries('Game', this)">Games</button>
        <button type="button" class="btn btn-outline-info filter-btn" onclick="filterEntries('Character', this)">Characters</button>
        <button type="button" class="btn btn-outline-success filter-btn" onclick="filterEntries('Location', this)">Locations</button>
    </div>

    <table class="table table-dark table-hover border-danger">
        <thead>
            <tr>
                <th>Type</th>
                <th>Name</th>
                <th>Info (Platform/Affil.)</th>
                <th>Year</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="entriesTable">
            @foreach (var item in Model)
            {
                <tr class="entry-row" data-category="@(item.Category ?? "Game")">
                    <td>
                        @if (item.Category == "Character")
                        {
                            <span class="badge bg-info text-dark">Character</span>
                        }
                        else if (item.Category == "Location")
                        {
                            <span class="badge bg-success">Location</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Game</span>
                        }
                    </td>
                    <td class="fw-bold">@item.Name</td>
                    <td>@item.Platform</td>
                    <td>@item.ReleaseYear.ToString("dd MMM yyyy")</td>
                    <td>
                        <div class="btn-group">
                            @{
                                var detailsAction = string.IsNullOrEmpty(item.PageName) ? "Details" : item.PageName;
                                int? detailsId = detailsAction == "Details" ? item.Id : (int?)null;
                            }
                            <a asp-controller="Home" asp-action="@detailsAction" asp-route-id="@detailsId"
                               class="btn btn-sm btn-info">Details</a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Games" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>

                                <button type="button" class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal"
                                        data-id="@item.Id" data-name="@item.Name">
                                    Delete
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true"
     data-delete-url="@Url.Action("Delete", "Games")">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-danger">
            <div class="modal-header border-danger">
                <h5 class="modal-title text-danger">CONFIRM DELETION</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Delete <strong id="deleteName"></strong> from the archive? This cannot be undone.
            </div>
            <div class="modal-footer border-danger">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" asp-controller="Games" asp-action="Delete" method="post">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/entries.js" asp-append-version="true"></script>
}