<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    <title>@ViewData["Title"] - RE Wiki</title>
    <link class="icon" type="image/png" href="~/photos/logo.png" />
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav id="wiki-sidebar" class="col-md-3 col-lg-2 bg-dark min-vh-100 p-3">
                <h4 class="text-danger mb-4 text-centerfw-bold">RESIDENT EVIL WIKI</h4>

                <div class="nav flex-column">
                    <form asp-controller="Home" asp-action="SearchRedirect" method="get" class="d-flex mb-3">
                        <input type="text" name="searchTerm" class="form-control bg-dark text-white border-danger"
                               placeholder="Search file (e.g. RE4)..." />
                        <button type="submit" class="btn btn-danger ms-2">GO</button>
                    </form>

                    <a class="nav-link text-light" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="nav-link text-light" asp-controller="Home" asp-action="Story">Main Story</a>
                    <a class="nav-link text-light" asp-controller="Games" asp-action="Gallery">Gallery</a>
                    <a class="nav-link text-light" asp-controller="Home" asp-action="Entries">Recent Entries</a>
                    <a class="nav-link text-warning mb-2" asp-controller="Games" asp-action="Roulette">🎰 Roulette</a>

                    <hr class="text-secondary" />

                    @if (User.Identity.IsAuthenticated)
                    {
                        <span class="px-3 text-muted small">AGENT SESSION</span>
                        <a class="nav-link text-white font-weight-bold" asp-controller="Profiles" asp-action="MyProfile">
                            <span class="text-success">●</span> My Profile
                        </a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a class="nav-link text-info" asp-controller="Games" asp-action="Create">🛠️ Editor (Add New)</a>
                        }

                        <hr class="text-secondary" />

                        <div class="px-3 mt-2">
                            <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 fw-bold text-start p-2">
                                    ❌ LOGOUT (@User.Identity.Name)
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <span class="px-3 text-muted small">GATEWAY</span>
                        <a class="nav-link text-warning" asp-controller="Account" asp-action="Login">🔑 Access Terminal (Login)</a>
                        <a class="nav-link text-success" asp-controller="Account" asp-action="Register">📝 New Agent (Register)</a>
                    }
                </div>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 p-5">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>