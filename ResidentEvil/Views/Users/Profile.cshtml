@model ResidentEvil.Models.Users

@{
    ViewData["Title"] = "User Profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark text-white border-danger shadow-lg">
                <div class="card-header border-danger text-center">
                    <h2 class="text-danger fw-bold">PERSONNEL FILE</h2>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <img src="https://via.placeholder.com/150/808080/FFFFFF?text=AGENT"
                             class="rounded-circle border border-danger p-2" alt="Avatar">
                    </div>

                    <div class="row mb-3 border-bottom border-secondary pb-2">
                        <div class="col-sm-4 text-danger fw-bold">CODENAME:</div>
                        <div class="col-sm-8 text-uppercase">@Model.Username</div>
                    </div>

                    <div class="row mb-3 border-bottom border-secondary pb-2">
                        <div class="col-sm-4 text-danger fw-bold">E-MAIL:</div>
                        <div class="col-sm-8 text-lowercase">@Model.Email</div>
                    </div>

                    <div class="row mb-3 border-bottom border-secondary pb-2">
                        <div class="col-sm-4 text-danger fw-bold">CLEARANCE:</div>
                        <div class="col-sm-8">
                            <span class="badge @(Model.Role == "Admin" ? "bg-danger" : "bg-secondary")">
                                @Model.Role
                            </span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 text-danger fw-bold">STATUS:</div>
                        <div class="col-sm-8 text-success fw-bold italic">ACTIVE / UNINFECTED</div>
                    </div>
                </div>
                <div class="card-footer border-danger text-center">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm">Modify Credentials</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">Return to Base</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card { background: rgba(20, 20, 20, 0.9) !important; border-width: 2px; }
    body { background-color: #0a0a0a; }
</style>