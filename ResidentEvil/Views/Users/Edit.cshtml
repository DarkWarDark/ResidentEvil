@model ResidentEvil.Models.Users

<h2 class="text-warning">EDIT USERS</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label>Username</label>
        <input asp-for="Username" class="form-control bg-dark text-white" />
    </div>
    <div class="mb-3">
        <label>Email</label>
        <input asp-for="Email" class="form-control bg-dark text-white" />
    </div>
    <div class="mb-3">
        <label>Role</label>
        <select asp-for="Role" class="form-control bg-dark text-white">
            <option value="Admin">Admin</option>
            <option value="User">User</option>
        </select>
    </div>
    <button type="submit" class="btn btn-warning">Save Changes</button>
</form>