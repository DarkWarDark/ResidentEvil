@model IEnumerable<ResidentEvil.Models.Users>

<h2 class="text-danger">USER ARCHIVE</h2>
<a asp-action="Create" class="btn btn-outline-light mb-3">Add New Users</a>

<table class="table table-dark">
    <thead>
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Username</td>
                <td>@u.Email</td>
                <td>@u.Role</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-warning">Edit</a>
                    <form asp-controller="Users" asp-action="Delete" asp-route-id="@u.Id" method="post"
                          class="d-inline" onsubmit="return confirm('Delete this user?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>