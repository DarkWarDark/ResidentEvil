@model IEnumerable<ResidentEvil.Models.UserListItem>

<div class="container mt-5">
    <h1 class="text-danger mb-4">PERSONNEL FILES</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <table class="table table-dark table-hover align-middle">
        <thead>
            <tr>
                <th>Username</th>
                <th>Role</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td class="fw-bold">@u.UserName</td>
                    <td>
                        @if (u.IsAdmin)
                        {
                            <span class="badge bg-danger">Admin</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">User</span>
                        }
                    </td>
                    <td class="text-end">
                        <form asp-action="ToggleAdmin" asp-route-id="@u.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-warning">
                                @(u.IsAdmin ? "Remove admin" : "Make admin")
                            </button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this user and their profile?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>