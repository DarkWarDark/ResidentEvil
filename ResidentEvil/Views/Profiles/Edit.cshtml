@model ResidentEvil.Models.Profiles

<h2 class="text-warning text-uppercase">Update Agent Records</h2>
<hr class="bg-warning" />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" class="bg-dark p-4 border border-warning text-white">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label">Biography / Background</label>
                <textarea asp-for="Bio" class="form-control bg-secondary text-white" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Favorite Resident Evil Game</label>
                <input asp-for="FavoriteGame" class="form-control bg-secondary text-white" />
            </div>

            <div class="mb-3">
                <label class="form-label">Avatar URL</label>
                <input asp-for="AvatarUrl" class="form-control bg-secondary text-white" />
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-warning">Save Changes</button>
                <a asp-action="MyProfile" class="btn btn-outline-light">Cancel</a>
            </div>
        </form>
    </div>
</div>