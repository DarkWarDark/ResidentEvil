@model ResidentEvil.Models.GalleryItem

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark border-warning shadow-lg">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0">EDIT EVIDENCE FILE</h3>
                </div>
                <div class="card-body text-white">
                    <form asp-action="EditPhoto" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label class="form-label">Subject</label>
                            <select asp-for="EntryId" class="form-select bg-secondary text-white border-0" asp-items="ViewBag.EntryId"></select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Image URL</label>
                            <input asp-for="ImageUrl" class="form-control bg-dark text-white border-secondary" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Caption</label>
                            <input asp-for="Caption" class="form-control bg-dark text-white border-secondary" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning fw-bold">UPDATE FILE</button>
                            <a asp-action="Gallery" class="btn btn-outline-light">CANCEL</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>