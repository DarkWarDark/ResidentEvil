@model ResidentEvil.Models.Entry

<div class="container mt-4 text-white">
    <h2 class="text-danger">REGISTER NEW GAME</h2>
    <hr class="bg-danger" />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div class="mb-3">
                    <label asp-for="Name" class="text-danger fw-bold">Name</label>
                    <input asp-for="Name" class="form-control bg-dark text-white border-secondary" />
                </div>
                <div class="mb-3">
                    <label asp-for="ReleaseYear" class="text-danger fw-bold">Appear Date</label>
                    <input asp-for="ReleaseYear" type="date" class="form-control bg-dark text-white border-secondary" />
                </div>
                <div class="mb-3">
                    <label asp-for="Platform" class="text-danger fw-bold">Platform/Affiliation</label>
                    <input asp-for="Platform" class="form-control bg-dark text-white border-secondary" />
                </div>
                <div class="mb-3">
                    <label asp-for="ImageUrl" class="text-danger fw-bold">Image URL</label>
                    <input asp-for="ImageUrl" class="form-control bg-dark text-white border-secondary"
                           placeholder="https://..." />
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="text-danger fw-bold">Description</label>
                    <textarea asp-for="Description" rows="6"
                              class="form-control bg-dark text-white border-secondary"></textarea>
                </div>
                <div class="form-group mb-3">
                    <label class="text-danger fw-bold">Select Type</label>
                    <select asp-for="Category" class="form-control bg-dark text-white border-danger">
                        <option value="Game">Game</option>
                        <option value="Character">Character</option>
                        <option value="Location">Location</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="text-danger fw-bold">LINKED PAGE NAME</label>
                    <input asp-for="PageName" class="form-control bg-dark text-white border-danger"
                           placeholder="Ex: RE4, Village, RE3..." />
                    <span asp-validation-for="PageName" class="text-danger small"></span>
                    <div class="form-text text-muted">Leave empty for a normal entry. Only fill in for a hand-written page (RE4, RE3, ...).</div>

                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-danger w-100">Save Game</button>
                    <a asp-action="Index" class="d-block text-center mt-2 text-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>