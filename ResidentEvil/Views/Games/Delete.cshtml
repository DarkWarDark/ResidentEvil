@model ResidentEvil.Models.Entry

<div class="container mt-4 text-white">
    <h1 class="text-danger">TERMINATE ENTRY?</h1>
    <h3 class="text-warning">Are you sure you want to delete this game record?</h3>
    
    <div class="mt-4 p-3 border border-danger bg-dark">
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Release Year</dt>
            <dd class="col-sm-9">@Model.ReleaseYear.ToString("dd MMM yyyy")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Confirm Deletion</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>